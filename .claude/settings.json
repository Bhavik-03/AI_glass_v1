{
  "permissions": {
    "allow": [
      "PowerShell(.venv\\Scripts\\python -m pytest *)",
      "PowerShell(.venv\\Scripts\\python -m ruff *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m ruff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Edit(**/docs/roadmap.md)",
      "Edit(**/docs/brief.md)",
      "Edit(**/docs/spec.md)",
      "Edit(**/docs/design.md)",
      "Edit(**/docs/hardware_plan.md)",
      "Edit(**/eval/questions.json)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/firmware/glasses/config.h)",
      "Edit(**/firmware/glasses/config.h)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.sh"],
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}